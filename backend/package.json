{
  "name": "food-traceability-backend",
  "version": "1.0.0",
  "description": "Food Traceability System Backend with Blockchain Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --passWithNoTests",
    "test:api-security": "jest tests/api-security.test.js",
    "test:signature-traceability": "jest tests/signature-traceability.test.js",
    "test:e2e-batch-signature": "jest tests/batch-signature-e2e.test.js",
    "test:all": "npm run test && npm run test:traceability",
    "test:blockchain": "node test-blockchain.js",
    "test:traceability": "node test-traceability.js",
    "test:ipfs": "node test-ipfs.js",
    "test:product-model": "node test-product-model.js",
    "migrate:batch-model": "node migrate-products-to-batches.js",
    "seed": "node seed-database.js",
    "seed:users": "node seed-database.js users",
    "seed:clean": "node seed-database.js clean",
    "migrate:dev-wallets": "node scripts/migrate-dev-wallets.js",
    "migrate:product-events": "node scripts/migrate-product-events.js",
    "backfill:blockchainlogs": "node scripts/backfill-blockchainlogs.js",
    "check:blockchainlogs": "node scripts/check-blockchainlogs.js",
    "truffle:compile": "truffle compile",
    "truffle:migrate": "truffle migrate --network development",
    "truffle:test": "truffle test",
    "truffle:console": "truffle console --network development"
  },
  "keywords": [
    "blockchain",
    "food-traceability",
    "express",
    "ethers.js"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@truffle/hdwallet-provider": "^2.1.15",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "truffle": "^5.11.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
